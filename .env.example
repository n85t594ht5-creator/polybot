# ─────────────────────────────────────────────
#  PolyBot — конфигурация (скопируй в .env)
#  Значения ниже = целевая конфигурация v1.5.0
# ─────────────────────────────────────────────

# ── Режим ──
MODE=paper                # paper — виртуальные сделки; live — реальные ордера
ASSETS=BTC,ETH,SOL,XRP    # какие монеты сканируем
WINDOWS=5,15              # длины окон в минутах (5m и 15m считаем как две отдельные стратегии)
BANKROLL=100              # стартовый банкролл, $

# ── Вход в сделку (momentum / late-window favorite) ──
MIN_ELAPSED=0.75          # входим только после 75% времени окна
MIN_ENTRY=0.50            # не покупать исход дешевле (рынок не согласен с движением)
MAX_ENTRY=0.62            # не покупать исход дороже (выплата не покрывает риск)
TIER_ENTRY=0.55           # граница двух уровней: <=0.55 → MIN_MOVE, дороже → MIN_MOVE_HIGH
MIN_MOVE=0.0010           # 0.10% — минимальное движение цены от старта окна
MIN_MOVE_HIGH=0.0012      # 0.12% — для более дорогого входа (> TIER_ENTRY)
MIN_CONF=0.70             # эвристический скор качества сигнала (шкала 0.725..0.935 — сейчас informational)
MOVE_MODE=pct             # pct — порог в процентах; sigma — в волатильностях (эксперимент)
MIN_SIGMA=1.5             # только для MOVE_MODE=sigma
REF_MODE=twap             # цена старта окна: twap (среднее минуты, ближе к Chainlink) | open

# ── Размер ставки ──
KELLY_FRAC=0.10           # доля от расчёта Келли (conf — эвристика, поэтому берём мало)
MAX_STAKE=0.05            # жёсткий потолок одной ставки: 5% банкролла

# ── Экспозиция и корреляция ──
MAX_POSITIONS=3           # одновременно открытых позиций
MAX_EXPOSURE=0.15         # суммарно в позициях: 15% банкролла
MAX_PER_WINDOW=1          # не больше 1 позиции на одно окно времени
MAX_SAME_DIR=2            # не больше 2 позиций в одну сторону (BTC/ETH/SOL ходят вместе)

# ── Аварийные лимиты ──
DAILY_LOSS_LIMIT=0.30     # <=1 — доля банкролла на начало дня (0.30 = 30%); >1 — сумма в $
CONSEC_LOSS_LIMIT=5       # убытков подряд → пауза
COOLDOWN_MIN=30           # длительность паузы, минут; после неё счётчик обнуляется
RATE_LIMIT=20             # максимум сделок в час
SKIP_HOURS=               # часы UTC без торговли, через запятую (пусто — круглосуточно)

# ── Исполнение ──
USE_BOOK=1                # учитывать стакан и входить на реально доступный объём
MAX_SLIP=0.01             # допустимое проскальзывание от лучшей цены
ORDER_WAIT_SEC=20         # сколько ждать исполнения ордера в live, затем снять остаток
PRICE_SOURCE=coinbase     # источник цены underlying (binance блокирует США)
LOOP_SEC=1.5              # пауза между циклами
MARKETS_TTL=30            # как часто обновлять список рынков, сек
PRE_ENTRY_SEC=60          # за сколько секунд до момента входа начинать опрашивать цены

# ── Live: ключи (в GitHub Secrets, не здесь) ──
POLY_PRIVATE_KEY=
POLY_FUNDER=
POLY_SIGNATURE_TYPE=0

# ── Уведомления ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Дашборд ──
DASH_PASSWORD=
DASH_PORT=8080
