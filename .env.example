# ─────────────────────────────────────────────
#  PolyBot config. Скопируй этот файл в .env
# ─────────────────────────────────────────────

# paper = виртуальные сделки, live = реальные ордера
MODE=paper

# ── Стратегия ──
ASSETS=BTC,ETH,SOL
BANKROLL=500            # $ — в paper режиме виртуальный
MAX_ENTRY=0.15          # не покупать исход дороже
MIN_ENTRY=0             # не покупать исход дешевле
MIN_ELAPSED=0.50        # входить не раньше половины окна
MIN_MOVE=0.0008         # цена должна уйти минимум на 0.08% от старта окна
TIER_ENTRY=0.45         # если исход дороже — нужно движение MIN_MOVE_HIGH
MIN_MOVE_HIGH=0.0012
MIN_CONF=0.60
KELLY_FRAC=0.25
MAX_POSITIONS=10
MAX_EXPOSURE=0.40       # доля банкролла в открытых позициях
WINDOWS=15,60           # какие окна торговать (минуты): 5, 15, 60
PRICE_SOURCE=coinbase   # coinbase (работает везде) или binance (блокирует США)

# ── Риск ──
DAILY_LOSS_LIMIT=50     # $ — стоп на день
CONSEC_LOSS_LIMIT=4     # подряд убытков → пауза 24ч
RATE_LIMIT=20           # сделок в час

# ── Кошелёк (ТОЛЬКО для MODE=live). Никому не показывай этот файл. ──
# Приватный ключ Polygon-кошелька, на котором лежит USDC.
POLY_PRIVATE_KEY=
# Адрес прокси-кошелька Polymarket (Profile → Settings → адрес депозита), если есть
POLY_FUNDER=
# 0 = обычный EOA-кошелёк (MetaMask), 1 = Magic/email-логин, 2 = Gnosis proxy
POLY_SIGNATURE_TYPE=0

# ── Уведомления (опционально) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Дашборд ──
# Пароль для входа в панель. Если задан — панель доступна с других устройств (телефон, комп).
DASH_PASSWORD=
DASH_PORT=8080
